# Éléa-Secours — dossier de DONNÉES (fichiers déposés, cache, extractions).
# Rien ici ne doit jamais être exécuté : ces fichiers viennent d'un dépôt utilisateur.
# Sans cette règle, un fichier « .php » déposé dans une activité (Dossier, Fichiers à
# distribuer, Travail à déposer) atterrissait à une adresse devinable et s'exécutait.

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phps|pht|phtml|shtml|cgi|pl|py|rb|jsp|asp|aspx|exe|bat|cmd|sh|so|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Ceinture et bretelles : couper le moteur PHP et tout gestionnaire de script.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phps .pht .phtml .shtml .cgi .pl .py .rb
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phps .pht .phtml .shtml .cgi .pl .py .rb
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
